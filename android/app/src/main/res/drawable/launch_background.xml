<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen drawable displayed by the LaunchTheme when the app starts.
    Shows a solid background with the app launcher icon centered.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid dark background to match app theme (no white flash) -->
    <item android:drawable="#0D1117" />

    <!-- App launcher icon centered -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
